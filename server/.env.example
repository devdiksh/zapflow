# Copy to server/.env and fill in. Never commit server/.env.

PORT=3000
MONGODB_URI=mongodb://localhost:27017/zapflow
APP_URL=http://localhost:4200

# Signs the session cookie. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# GitHub OAuth App: github.com → Settings → Developer settings → OAuth Apps → New
#   Homepage URL:               http://localhost:4200
#   Authorization callback URL: http://localhost:4200/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4200/api/auth/github/callback
